{
  "components": {
    "schemas": {
      "Body_upload_api_v1_documents_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "role": {
            "default": "primary",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_documents_post",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReviewDecisions": {
        "properties": {
          "excluded_findings": {
            "items": {
              "minimum": 0.0,
              "type": "integer"
            },
            "maxItems": 100000,
            "title": "Excluded Findings",
            "type": "array"
          },
          "revision": {
            "default": 0,
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "source_report_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Source Report Sha256",
            "type": "string"
          }
        },
        "required": [
          "source_report_sha256"
        ],
        "title": "ReviewDecisions",
        "type": "object"
      },
      "ReviewRequest": {
        "properties": {
          "custom_prompt": {
            "default": "",
            "maxLength": 10000,
            "title": "Custom Prompt",
            "type": "string"
          },
          "degree": {
            "default": "master",
            "enum": [
              "bachelor",
              "master",
              "doctor",
              "unknown"
            ],
            "title": "Degree",
            "type": "string"
          },
          "document_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Document Ids",
            "type": "array"
          },
          "language": {
            "default": "zh-CN",
            "enum": [
              "zh-CN",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "material_type": {
            "default": "thesis",
            "enum": [
              "proposal",
              "progress",
              "thesis",
              "paper"
            ],
            "title": "Material Type",
            "type": "string"
          },
          "model_mode": {
            "default": "local",
            "enum": [
              "mock",
              "local"
            ],
            "title": "Model Mode",
            "type": "string"
          },
          "policy_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Policy Ids",
            "type": "array"
          }
        },
        "required": [
          "document_ids"
        ],
        "title": "ReviewRequest",
        "type": "object"
      },
      "SearchRequest": {
        "properties": {
          "approved": {
            "default": false,
            "title": "Approved",
            "type": "boolean"
          },
          "query": {
            "maxLength": 300,
            "minLength": 2,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "TextInput": {
        "properties": {
          "text": {
            "maxLength": 1000000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "title": {
            "default": "粘贴的材料",
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "TextInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
